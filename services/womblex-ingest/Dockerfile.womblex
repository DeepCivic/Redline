# womblex worker — the real womblex engine as its own pod (Thread 37a).
#
# womblex is a REQUIRED subsystem of redline (Finding 2 / D5): the retrieval leg
# IS womblex's *.embeddings.parquet. It lives in its OWN image, deliberately not
# folded into the lightweight womblex-ingest API image, because its runtime
# (PyMuPDF, rapidocr-onnxruntime OCR, ultralytics/YOLO layout, semchunk + the
# Kanon tokeniser, model weights) is multi-hundred-MB and its resource profile is
# disparate from the FastAPI sidecar's. Co-locating them would couple unlike
# lifecycles and bloat the API pod with a stack it never runs.
#
# This image is a LOCAL TEST HARNESS (Thread 37a): it stands the real engine up
# under Podman so the binding (Thread 37b) and the real-corpus retrieval proof
# have a real engine to run against. HOW the worker is scheduled in production (a
# job, a scaled worker fleet, a GPU node) is a deployment choice — the seam is
# object storage (ADR-0002), so it is not baked in here.
#
# womblex requires Python 3.11/3.12 and its OCR dep (rapidocr-onnxruntime>=1.4)
# has no wheel for 3.10; pin 3.12 so the transitive stack resolves.
FROM python:3.12-slim

# womblex pin — mirrors wayfinder.pin's reproducibility discipline: a moving
# version could turn the real lane red with nothing changed on our side.
ARG WOMBLEX_VERSION=0.2.0

# Runtime libs the OCR / layout stack needs (opencv, onnxruntime): libGL + glib.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "womblex==${WOMBLEX_VERSION}"

# mc (MinIO client) so the entrypoint can sync the shard directory to the shared
# bucket without a host dependency — the pod's only seam is object storage.
RUN pip install --no-cache-dir "minio>=7,<8"

WORKDIR /work

# INPUT_DIR  — mounted corpus of source documents to extract.
# OUTPUT_DIR — where womblex writes its run/shard directory before sync.
# EVALUATION_ID — the proc/{evaluationId}/ prefix the shards land under.
# S3_* / REDLINE_BUCKET — the shared MinIO (ADR-0002).
# ISAACUS_API_KEY — engages the embed stage (kanon-2-embedder); *.embeddings.parquet
#   is only produced when it is set.
ENV INPUT_DIR=/work/input \
    OUTPUT_DIR=/work/output \
    EVALUATION_ID=womblex-pod \
    S3_ENDPOINT=http://minio:9000 \
    S3_ACCESS_KEY=minioadmin \
    S3_SECRET_KEY=minioadmin \
    REDLINE_BUCKET=redline

COPY womblex-pod-entrypoint.sh /usr/local/bin/womblex-pod-entrypoint.sh
RUN chmod +x /usr/local/bin/womblex-pod-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/womblex-pod-entrypoint.sh"]
