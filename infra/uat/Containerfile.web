# UAT-only container for the forked Wayfinder web app (@wayfinder/web).
#
# WHY this exists: the fork ships no Dockerfile — docs/guides/two-stack-local-run.md
# runs apps/web on the host with `pnpm dev`. UAT here requires everything in pods,
# so this image builds and serves the app instead. It is local testing scaffolding,
# not a shipped artefact.
#
# WHY the build context is the PARENT redline repo (not services/wayfinder): the
# fork's pnpm workspace globs in `../../apps/*` and `../../packages/*` — the parent's
# @redline/* packages — so a build needs BOTH trees with the fork sitting at
# services/wayfinder, exactly as it does on disk. Build from the repo root:
#   podman build -f infra/uat/Containerfile.web -t redline-wayfinder-web:uat .

FROM docker.io/library/node:20-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
# native deps for the fork's build (onnxruntime-node / sharp / pdf tooling) and
# the migrate step's pg client; python3+make+g++ cover node-gyp rebuilds.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates python3 make g++ postgresql-client \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

WORKDIR /app

# The fork lives two levels below the workspace root it globs from, so the whole
# parent tree is copied with the fork in place. .containerignore keeps node_modules
# and build output out so the install/build happen fresh and reproducibly.
FROM base AS build
COPY . .

# Two overlapping pnpm workspaces are in play. The parent redline workspace owns
# @types/node and the rest of the @redline/* build deps at its ROOT (they are not
# restated in each package.json), so building @redline/* needs a parent-root
# install to hoist them. The fork workspace (services/wayfinder) then resolves
# @rbrasier/* AND globs the parent's @redline/* packages. Install parent first so
# the @redline/* type deps exist, then the fork. --frozen-lockfile is off: the
# committed lockfiles assume trees this combined image does not reproduce.
WORKDIR /app
RUN pnpm install --no-frozen-lockfile

WORKDIR /app/services/wayfinder
RUN pnpm install --no-frozen-lockfile

# Build only what the web app needs. turbo resolves the @redline/* and @rbrasier/*
# package builds @wayfinder/web depends on.
RUN pnpm --filter @wayfinder/web... build

FROM base AS runtime
ENV NODE_ENV=production
# Bring the built workspace across whole: next start reads .next, and the app's
# server bundle still resolves workspace deps out of the shared node_modules.
COPY --from=build /app /app
WORKDIR /app/services/wayfinder/apps/web
EXPOSE 3000
# `pnpm start` runs migrate-if-configured.sh (migrates when DATABASE_URL is set)
# then `next start -p ${WEB_PORT:-3000}`.
CMD ["pnpm", "start"]
