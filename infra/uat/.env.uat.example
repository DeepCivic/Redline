# Template for infra/uat/.env.uat, which is gitignored because the real file
# holds live API keys. Copy it and fill in:
#
#   cp infra/uat/.env.uat.example infra/uat/.env.uat
#
# Only the three secrets in the first block are mandatory — the fork's compose
# declares them `:?` and refuses to start without them. Everything else has a
# working default in infra/uat/docker-compose.yml; the values below restate the
# defaults so the file reads as a complete picture of the run.
#
# Generate the three secrets with: openssl rand -hex 32

BETTER_AUTH_SECRET=
SETTINGS_ENCRYPTION_KEY=
SCHEDULER_TICK_SECRET=

# ── the fork's own storage and admin ────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@example.com
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── redline's services (must match infra/.env — one MinIO, one bucket) ──────
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
REDLINE_BUCKET=redline
REDLINE_DB_USER=redline
REDLINE_DB_PASSWORD=redline-dev
REDLINE_DB_NAME=redline

# `stub` serves fabricated shards. A UAT run left on it looks like it succeeded
# while showing invented documents — see README §1.
WOMBLEX_MODE=real
WOMBLEX_EVAL_ID=

# ── AI providers ────────────────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=

# Blank on purpose: nothing can be seeded without it, because cold-start
# classification is hard rules plus LLM adjudication. See README §5.
REDLINE_ADJUDICATOR_API_KEY=

REDLINE_PRODUCT_NAME=the product

# Gates BOTH chunk and embed in `womblex run-stage` — chunk makes no API call
# (the Kanon-2 tokeniser is vendored) but the contract still requires the key.
ISAACUS_API_KEY=

# ── observability (optional) ────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
