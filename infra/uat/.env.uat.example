# UAT env — the SINGLE file both stacks read. NOT for deployment.
# Regenerate secrets with `openssl rand -hex 32`.
#
# Both compose projects load this file:
#   redline services : podman compose -f infra/docker-compose.yml --profile ingest up -d
#   the fork + web   : podman compose -f infra/uat/docker-compose.yml \
#                        --env-file infra/uat/.env.uat up -d
#
# The first command needs no --env-file because `infra/.env` is a symlink to this
# file, and compose auto-loads `.env` from the project directory. That symlink is
# deliberate: a forgotten --env-file would silently fall back to the compose
# defaults, and one of those defaults is WOMBLEX_MODE=stub — a run that fabricates
# documents while looking healthy.

# ── fork bootstrap secrets (required at startup) ─────────────────────────────
BETTER_AUTH_SECRET=
SETTINGS_ENCRYPTION_KEY=
SCHEDULER_TICK_SECRET=

# ── admin bootstrap ──────────────────────────────────────────────────────────
# Binds the installation to this address: the first-admin endpoint rejects any
# other email. Already consumed — admin@example.com exists.
ADMIN_SEED_EMAIL=admin@example.com

# ── object storage ───────────────────────────────────────────────────────────
# MINIO_* is the FORK's bucket. S3_* is redline's, where womblex lands shards.
# The redline seam is plain S3, so S3_* repoints at AWS unchanged.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
REDLINE_BUCKET=redline

# ── redline's own Postgres (never Wayfinder's) ─────────────────────────
REDLINE_DB_USER=redline
REDLINE_DB_PASSWORD=redline-dev
REDLINE_DB_NAME=redline

# ── womblex engine ───────────────────────────────────────────────────────────
# `real` reads the shards the engine landed. `stub` is the compose default and a
# TEST DOUBLE serving fabricated documents — a UAT run left on it looks like it
# succeeded. Confirm with: curl -s localhost:8000/health
WOMBLEX_MODE=real

# The prefix a run publishes under. Shards land at proc/{WOMBLEX_EVAL_ID}/ and
# the sidecar reads proc/{evaluationId}/ — these MUST match the manifest's
# evaluationId or the evaluation reads empty.
WOMBLEX_EVAL_ID=cloud-rft-2026

# ═════════════════════════════════════════════════════════════════════════════
# API KEYS — populate below this line.
#
# Apply web-app keys with:
#   podman compose -f infra/uat/docker-compose.yml --env-file infra/uat/.env.uat \
#     up -d wayfinder-web
# Engine keys (ISAACUS_API_KEY) are read at the next womblex run — no restart.
#
# Only secrets and genuine choices live here. Endpoints, models and regions are
# defaulted in the compose files, where they cannot be got wrong: compose
# substitutes its default on an empty value as well as a missing one, so
# blanking or deleting any line below is safe.
# ═════════════════════════════════════════════════════════════════════════════

# ── Wayfinder's own AI (its chat, synthesise and flow steps) ─────────────────
# Set the provider to match the key you fill in — it defaults to anthropic, so an
# OpenAI key alone leaves Wayfinder calling a provider it has no key for.
# NOTE: a Groq key does NOT work here. The provider list is a closed enum and the
# OpenAI client is built with no baseURL, so Groq credentials would go to
# api.openai.com and 401. Use Anthropic, OpenAI, Mistral or Bedrock.
# Keys can also be entered in the admin Settings page, encrypted at rest with
# SETTINGS_ENCRYPTION_KEY; env wins when both are present.
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Amazon Bedrock (only when AI_DEFAULT_PROVIDER=bedrock). Region defaults to
# us-east-1 in compose. This is the AWS surface that exists today — there is no
# SageMaker adapter anywhere in redline or the fork.
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=

REDLINE_PRODUCT_NAME=the product

# ── Isaacus (the womblex engine, not the fork) ──────────────────────────────
# NEVER BLANK THIS. isaacus_available() gates the CHUNK stage on the SDK being
# importable AND this being non-empty. Empty means the engine lands extraction
# shards with no chunks — silently — and chunks are the only thing the cold-start
# classifier reads.
#
# `uat-local` is a fully working value for chunking: with no chunking_model set
# (redline's profile sets none) the Kanon-2 tokeniser resolves from womblex's
# vendored copy and makes no API call. A REAL key only buys the embed stage
# (kanon-2-embedder), whose output stays inert while v1 stays point-only (see
# docs/Redline-Plan.md §1.1). Paste a real key only if you want to exercise embed.
#
ISAACUS_API_KEY=uat-local

# ── langfuse tracing (optional) ─────────────────────────────────────────────
# Both keys must be present or tracing stays stubbed. Mint them at
# http://localhost:3030. The host is set in compose.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── langfuse's own bootstrap secrets (not API keys) ─────────────────────────
LANGFUSE_NEXTAUTH_SECRET=replace-me-uat
LANGFUSE_SALT=replace-me-uat
