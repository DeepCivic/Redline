# redline runtime stack — environment overrides for infra/docker-compose.yml.
#
# Copy to infra/.env and fill in. Compose reads that file automatically; every
# value below has a dev default baked into the compose file, so this file is
# what stops those defaults reaching anything real.
#
# THE DEV DEFAULTS ARE NOT SHIPPABLE. `minioadmin` / `redline-dev` /
# `numbatch-dev` exist so any single profile comes up standalone on a laptop.
# A deployment that does not override them is running with published
# credentials.

# ── The two settings a run is most often wrong about ─────────────────────────

# `real` reads the shards the womblex engine landed in object storage. `stub`
# (the compose default) is a dependency-free TEST DOUBLE that serves
# deterministic fabricated documents — it exists for CI, and a run left on it
# looks like it succeeded. Confirm with `curl localhost:8000/health`.
WOMBLEX_MODE=real

# Gates womblex's chunk AND embed stages. The chunk gate is a policy refusal,
# not a capability limit: with no `chunking_model` set (redline's profile sets
# none) the Kanon-2 tokeniser resolves from the engine's vendored copy and no
# API call is made, so ANY non-empty value produces chunks offline. Only `embed`
# spends against a real key, and its output stays inert while v1 stays
# point-only (see docs/Redline-Plan.md §1.1). A UAT run needs no Isaacus account.
ISAACUS_API_KEY=uat-local

# ── Object storage ───────────────────────────────────────────────────────────
# The seam is plain S3, so these repoint at AWS S3 unchanged.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
REDLINE_BUCKET=redline

# The evaluation prefix a womblex run publishes under: shards land at
# proc/{WOMBLEX_EVAL_ID}/ and the sidecar reads them back from proc/{evaluationId}/.
# These MUST match or the evaluation reads empty.
WOMBLEX_EVAL_ID=

# ── redline's own Postgres (never Wayfinder's) ─────────────────────────
REDLINE_DB_USER=redline
REDLINE_DB_PASSWORD=
REDLINE_DB_NAME=redline
# Leave unset to compose from the three above; set it to point at an external
# instance (RDS, a shared cluster) instead of the redline-postgres service.
REDLINE_DATABASE_URL=

# ── Numbatch stack (only for the `numbatch` profile) ─────────────────────────
# Not on the lean vertical — it re-enters when a trained overlay or the
# financial extension's roll-up is wanted.
NUMBATCH_DB_USER=numbatch
NUMBATCH_DB_PASSWORD=
NUMBATCH_DB_NAME=numbatch
NUMBATCH_ADAPTERS_BUCKET=numbatch-adapters
NUMBATCH_BASE_MODEL=answerdotai/ModernBERT-base
NUMBATCH_DEVICE=auto
