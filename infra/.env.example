# redline runtime stack — environment overrides for infra/docker-compose.yml.
#
# Copy to infra/.env and fill in. Compose reads that file automatically; every
# value below has a dev default baked into the compose file, so this file is
# what stops those defaults reaching anything real.
#
# THE DEV DEFAULTS ARE NOT SHIPPABLE. `minioadmin` exists so a profile comes up
# standalone on a laptop. A deployment that does not override it is running with
# published credentials.

# ── The setting a run is most often wrong about ──────────────────────────────

# `real` reads the shards the Womblex engine landed in object storage. `stub`
# (the compose default) is a dependency-free TEST DOUBLE that serves
# deterministic fabricated documents — it exists for CI, and a run left on it
# looks like it succeeded. Confirm with `curl localhost:8000/health`.
WOMBLEX_MODE=real

# ── Object storage ───────────────────────────────────────────────────────────
# The seam is plain S3, so these repoint at AWS S3 unchanged. redline reads this
# bucket; the Womblex engine writes it. Both must be pointed at the same one.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
REDLINE_BUCKET=redline

# ── The MCP surface ──────────────────────────────────────────────────────────
# Where apps/redline-mcp finds the read sidecar. The compose default resolves
# inside the stack; set it when the two are deployed apart.
WOMBLEX_INGEST_URL=http://womblex-ingest:8000
