node_modules/
dist/
coverage/
.turbo/
*.log
.env
.env.local
# Suffixed env files hold real API keys. The bare `.env` pattern above does not
# match them.
.env.*
!.env.example
!.env.*.example
.DS_Store

# Podman validation scratch (created by scripts/podman-run.sh if SCRATCH_BASE is set here)
.redline-scratch/

# Wayfinder is consumed read-only and never committed. It is materialised locally
# (or at build time) into this scratch copy carrying node_modules and build
# artefacts, so keep it untracked.
vendor/
__pycache__/

# Machine-local Claude Code tooling state: a permissions audit log carrying
# absolute workstation paths and transient command history (stale commit refs
# and all). Per-machine, not project source — the tracked .claude/ files are
# CLAUDE.md and the command docs, never this.
.claude/settings.json
.claude/settings.local.json

# Non-redistributable local test corpus. The
# committed fixture corpus is services/womblex-ingest/tests/corpus/ (must be
# redistributable); real/sensitive documents live here and are never committed.
# Point the pod at them with WOMBLEX_CORPUS=.../tests/corpus-local.
services/womblex-ingest/tests/corpus-local/*
!services/womblex-ingest/tests/corpus-local/README.md

# uv's resolver lock for the sidecar. Not the project's workflow: this package's
# documented dev path is `python3 -m venv && pip install -e '.[dev]'` (see its
# README), and no other Python service here carries a lock. `uv run` writes this
# whenever someone uses uv to get a quick test env, so keep it local rather than
# committing a second, drifting source of dependency truth beside pyproject.toml.
services/womblex-ingest/uv.lock
