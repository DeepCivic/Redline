node_modules/
dist/
coverage/
.turbo/
*.log
.env
.env.local
.DS_Store

# Podman validation scratch (created by scripts/podman-run.sh if SCRATCH_BASE is set here)
.redline-scratch/
__pycache__/

# Wayfinder is consumed read-only and never committed (validate.sh check #6).
# CI materialises vendor/wayfinder at build time via scripts/vendor-wayfinder.sh;
# local Podman dev vendors into its own scratch copy. Either way, keep it untracked.
vendor/

# No committed lockfile pre-1.0 — a local `pnpm install` generates one, but CI
# deliberately runs without it (see .github/workflows/ci.yml: package-manager
# caching is disabled precisely because no lockfile is committed). To land a
# lockfile, delete this rule and flip CI to `cache: pnpm` in the same change.
pnpm-lock.yaml
