{
  "name": "@redline/redline-adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Adapters: womblex extraction reader, Numbatch client, redline_ repositories.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/persistence/migrations','dist/persistence/migrations',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/persistence/migrate.ts"
  },
  "dependencies": {
    "@redline/redline-application": "workspace:*",
    "@redline/redline-domain": "workspace:*",
    "@redline/redline-shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "minio": "^8.0.7",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "optionalDependencies": {
    "@rbrasier/domain": "workspace:*"
  }
}
