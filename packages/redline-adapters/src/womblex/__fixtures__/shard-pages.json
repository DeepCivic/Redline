        ]
      },
      {
        "source_hash": "c5c98a362f5f91931e96c128ce00adb875f4a084cd6cc1edd0738b7fb00cef54",
        "collection_id": "",
        "elem_order": 6,
        "kind": "list_item",
        "extractor": "native_text",
        "confidence": 0.8999999761581421,
        "page": 0,
        "bbox": {
          "x": 0.13093988597393036,
          "y": 0.7552191615104675,
          "width": 0.7542286515235901,
          "height": 0.14613471925258636
        },
        "text": "• Records of conversation and educator statements; • Link to map of service and child attendance list; and • Information and actions. Refer Attachment B.  7. On 28 February 2023, the Provider submitted additional information via the NQAITS portal. This information consisted of records relevant to the Provider’s internal investigation of the incident, findings and outcomes – Please refer investigation reports submitted at Attachment C.",
        "alt_text": null,
        "header_rows": null,
